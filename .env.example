# Copy to .env (or run ./scripts/init-env.sh, which fills in random secrets).
# Use letters and digits only for passwords: they are placed inside URLs.

POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
REDIS_PASSWORD=change-me-use-openssl-rand-hex-24

# Dashboard admin login (HTTP basic auth). Password: at least 12 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-at-least-12-chars

# Signs API keys (openssl rand -hex 32). Only keys signed with it pass the
# format check, so made-up keys never reach Postgres. Changing it later
# invalidates every existing key.
KEY_SECRET=change-me-use-openssl-rand-hex-32

# Keeps CSRF tokens valid across restarts (openssl rand -hex 32). Optional.
CSRF_SECRET=

# Store used until you pick one in the dashboard: redis (the fix) or memory (the bug).
LIMITER_STORE=redis

# Production only (docker compose --profile prod): your domain for HTTPS.
DOMAIN=yourname.duckdns.org

# "Try it yourself" button on the live page (demo key, 3 requests per 10 seconds): on or off.
DEMO_KEY=on

# Load test caps. 1,000 req/s is a safe ceiling on a 2-OCPU VM where the load
# generator shares the CPU with everything else; measure before raising it.
LOADTEST_MAX_RPS=1000
LOADTEST_MAX_DURATION=60s
LOADTEST_MAX_CLIENTS=50
